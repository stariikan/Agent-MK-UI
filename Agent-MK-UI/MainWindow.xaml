<Window
  x:Class="Agent_MK_UI.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  mc:Ignorable="d"
>
    <!-- The Window object cannot have a background. We apply the base OS theme color to the root Grid. -->
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Grid
      x:Name="AppTitleBar"
      Grid.Row="0"
      Background="{ThemeResource LayerFillColorDefaultBrush}"
      Height="44"
    >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="RightPaddingColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <TextBlock
        Grid.Column="0"
        Text="Agent-MK"
        FontSize="16"
        FontWeight="Bold"
        VerticalAlignment="Center"
        Margin="14,0,14,0"
        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
      />

            <TextBlock
        Grid.Column="1"
        x:Name="OllamaStatsText"
        Text="Ollama: checking..."
        VerticalAlignment="Center"
        TextTrimming="CharacterEllipsis"
        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
        FontSize="11"
      />

            <Button
        Grid.Column="2"
        x:Name="SettingsButton"
        Margin="0,0,14,0"
        Background="Transparent"
        BorderBrush="Transparent"
        Click="SettingsButton_Click"
      >
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <TextBlock Text="Settings" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Three-pane layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: chat list -->
            <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
            x:Name="ChatCountText"
            Grid.Column="0"
            Text="Chats (0/30)"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            FontSize="12"
          />
                    <!-- ARCHITECTURAL FIX: Explicitly set VerticalAlignment to Center to align baseline with the text -->
                    <Button
            x:Name="NewChatButton"
            Grid.Column="1"
            Content="+ New"
            Padding="8,3"
            VerticalAlignment="Center"
            Style="{StaticResource AccentButtonStyle}"
            Click="NewChatButton_Click"
          />
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ChatListPanel" Margin="6" />
                </ScrollViewer>
            </Grid>

            <!-- CENTER: conversation -->
            <Grid Grid.Column="1" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- ARCHITECTURAL FIX: Added Padding="0,0,16,0" to create a gutter for the WinUI overlay scrollbar. -->
                <ScrollViewer
          x:Name="ChatScrollViewer"
          Grid.Row="0"
          Margin="16,16,2,8"
          Padding="0,0,16,0"
          VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled"
        >
                    <!-- ARCHITECTURAL FIX: Enforced VerticalAlignment="Top" to prevent layout jumping/clipping. -->
                    <StackPanel x:Name="ChatHistoryPanel" VerticalAlignment="Top" />
                </ScrollViewer>

                <!-- Context window usage -->
                <Grid Grid.Row="1" Margin="16,0,16,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ProgressBar
            x:Name="ContextUsageBar"
            Grid.Row="0"
            Height="4"
            Minimum="0"
            Maximum="1"
            Value="0"
          />
                    <TextBlock
            x:Name="ContextUsageText"
            Grid.Row="1"
            Text=""
            FontSize="11"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Margin="0,3,0,0"
          />
                </Grid>

                <Grid Grid.Row="2" Margin="16,0,16,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
            x:Name="UserInputBox"
            Grid.Row="0"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            MinHeight="120"
            MaxHeight="320"
            Background="{ThemeResource ControlFillColorDefaultBrush}"
            Foreground="{ThemeResource TextFillColorPrimaryBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            FontFamily="Consolas"
            FontSize="13"
            Padding="10"
            Text=""
          />

                    <!-- ARCHITECTURAL FIX: Restructured Grid layout to remove Attach File button -->
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Adjusted hint text to remove attachment references -->
                        <TextBlock
              Grid.Column="0"
              x:Name="InputHintText"
              Text="Enter to send, Shift+Enter for a new line."
              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
              FontSize="11"
              VerticalAlignment="Center"
              TextWrapping="Wrap"
            />

                        <Button
              x:Name="SendButton"
              Grid.Column="1"
              Content="Send"
              Width="100"
              Padding="10,6"
              Style="{StaticResource AccentButtonStyle}"
              Click="SendButton_Click"
            />
                    </Grid>
                </Grid>
            </Grid>

            <!-- RIGHT: project tree -->
            <Grid Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
          Grid.Row="0"
          Text="Project"
          FontWeight="SemiBold"
          Margin="10,10,10,4"
          Foreground="{ThemeResource TextFillColorPrimaryBrush}"
        />

                <StackPanel Grid.Row="1" Margin="10,0,10,8">
                    <TextBlock
            x:Name="ProjectPathText"
            Text="No project attached"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            FontSize="11"
            Margin="0,0,0,4"
          />
                    <TextBlock
            x:Name="ProjectStatsText"
            Text="Attach a project to inspect its files."
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            FontSize="10"
            Margin="0,0,0,8"
          />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button
              x:Name="AttachProjectButton"
              Content="Attach"
              Padding="8,4"
              Click="AttachProjectButton_Click"
            />
                        <Button
              x:Name="RefreshProjectButton"
              Content="Refresh"
              IsEnabled="False"
              Padding="8,4"
              Style="{StaticResource AccentButtonStyle}"
              Click="RefreshProjectButton_Click"
            />
                        <Button
              x:Name="ReviewProjectButton"
              Content="Review"
              IsEnabled="False"
              Padding="8,4"
              Style="{StaticResource AccentButtonStyle}"
              Click="ReviewProjectButton_Click"
            />
                    </StackPanel>
                    <Button
            x:Name="RemoveProjectButton"
            Content="Remove Project"
            IsEnabled="False"
            Padding="8,4"
            Style="{StaticResource AccentButtonStyle}"
            Click="RemoveProjectButton_Click"
            Margin="0,6,0,0"
          />
                </StackPanel>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ProjectTreePanel" Margin="6" />
                </ScrollViewer>
            </Grid>
        </Grid>
        <TextBlock Grid.Row="0" Grid.RowSpan="2"
   FontSize="10"
   Foreground="{ThemeResource TextFillColorTertiaryBrush}"
   Opacity="0.6"
   HorizontalAlignment="Left"
   VerticalAlignment="Bottom"
   Margin="15,0,10,6"
   IsHitTestVisible="False">
    Agent-MK - v0.15
    <LineBreak />
    Created by Murat Khabriev
        </TextBlock>
        <!-- Settings Overlay Host -->
        <Grid
      x:Name="SettingsOverlayHost"
      Grid.Row="0"
      Grid.RowSpan="2"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
      Visibility="Collapsed"
      Canvas.ZIndex="100"
    ></Grid>
    </Grid>
</Window>
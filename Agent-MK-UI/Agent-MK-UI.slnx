<Solution>
  <Configurations>
    <Platform Name="Any CPU" />
    <Platform Name="ARM64" />
    <Platform Name="x64" />
  </Configurations>
  <Project Path="../Orchestra.Core/Orchestra.Core.csproj">
    <Platform Solution="*|x64" Project="x64" />
    <Build Solution="*|Any CPU" Project="false" />
    <Build Solution="*|ARM64" Project="false" />
  </Project>
  <Project Path="../Orchestra.Infrastructure/Orchestra.Infrastructure.csproj">
    <Platform Solution="*|x64" Project="x64" />
    <Build Solution="*|Any CPU" Project="false" />
    <Build Solution="*|ARM64" Project="false" />
  </Project>
  <Project Path="Agent-MK-UI.csproj">
    <Platform Solution="*|ARM64" Project="ARM64" />
    <Platform Solution="Debug|Any CPU" Project="x64" />
    <Platform Solution="Debug|x64" Project="x64" />
    <Platform Solution="Release|x64" Project="ARM32" />
    <Deploy Solution="Release|x64" />
  </Project>
</Solution>
